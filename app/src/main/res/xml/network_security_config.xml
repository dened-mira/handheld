<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Allow connections to the local access controller over HTTPS with self-signed cert.
         SSL verification is handled in code (AccessController) — no cleartext needed. -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="false">192.168.100.5</domain>
    </domain-config>
</network-security-config>
